 "economyFacts": [
  {
   "fact": "Money is US-style in-game dollars ($). Three forms exist: BuckMe bank balance (safe), carried pocket cash, and unfenced stash-bag loot that must be sold at a fence/drop-off before it becomes cash.",
   "sources": [
    "gtabase-money",
    "gamesgg-money"
   ],
   "status": "COMMUNITY_REPORTED"
  },
  {
   "fact": "BuckMe is the in-game banking app; the account is opened during the Chapter 1 story mission 'Buck Me'.",
   "sources": [
    "vgc-buckme",
    "gamesgg-money"
   ],
   "status": "VERIFIED_SECONDARY"
  },
  {
   "fact": "BuckMe account limits are capped and rise only through main-story progression; payments blocked by a full Checking account are processed after the story upgrade.",
   "sources": [
    "rockstar-support-buckme"
   ],
   "status": "VERIFIED_OFFICIAL"
  },
  {
   "fact": "Pocket cash must be deposited at a physical ATM (not via the phone). Being wasted or busted loses carried cash (plus a small BuckMe fee per GTABase); banked money is untouched.",
   "sources": [
    "gtabase-money",
    "gamesgg-money"
   ],
   "status": "COMMUNITY_REPORTED"
  },
  {
   "fact": "Pocket cash is capped at $20,000 per character.",
   "sources": [
    "gtabase-money"
   ],
   "status": "COMMUNITY_REPORTED"
  },
  {
   "fact": "Jason and Lucia appear to share one money pool / savings account. One guide (stack-archive) claims each has a separate account. No Rockstar statement found.",
   "sources": [
    "gamesgg-money",
    "vgc-buckme",
    "stack-archive-money"
   ],
   "status": "CONFLICTED"
  },
  {
   "fact": "Some main-story missions are gated behind reaching cash/bank targets, so players must earn money to progress.",
   "sources": [
    "gamesradar-broke",
    "gtabase-money"
   ],
   "status": "VERIFIED_SECONDARY"
  },
  {
   "fact": "BuckMe Family Savings tiers reportedly grant perks; the $100,000 'BuckMe Gold' tier reportedly gives 20% off garages. Not confirmed by Rockstar.",
   "sources": [
    "gta6house-garages",
    "theclick-familysavings"
   ],
   "status": "COMMUNITY_REPORTED"
  },
  {
   "fact": "Stolen cars can be sold to fences or registered as personal vehicles at Pay 'n' Spray or Moses; registration costs roughly 2-3x what a fence pays. The first registration with Moses is free.",
   "sources": [
    "gamespot-moses",
    "sportskeeda-cars",
    "gtabase-carsteal"
   ],
   "status": "VERIFIED_SECONDARY"
  },
  {
   "fact": "The WAINK phone app scan shows a car's security, tracker, fence value and registration cost. Trackers and damage reduce fence payouts.",
   "sources": [
    "gta6life-property",
    "gtabase-carsteal"
   ],
   "status": "COMMUNITY_REPORTED"
  },
  {
   "fact": "Houses and apartments cannot be bought in story mode; only garages are purchasable (via the Vice City Real Estate app, unlocked after Chapter 2 mission 'Daily Driver'). Safehouses are given by the story.",
   "sources": [
    "vgc-houses",
    "powerpyx-garages",
    "gta6house-garages"
   ],
   "status": "VERIFIED_SECONDARY"
  },
  {
   "fact": "Every purchasable garage holds exactly one vehicle; price reflects location only. Some story garages hold 2-3. Max ~20 personal vehicle slots.",
   "sources": [
    "powerpyx-garages",
    "gta6house-garages"
   ],
   "status": "COMMUNITY_REPORTED"
  },
  {
   "fact": "Purchased garages/properties do not generate passive income.",
   "sources": [
    "gta6house-garages"
   ],
   "status": "COMMUNITY_REPORTED"
  },
  {
   "fact": "GTA+ (real-money subscription) gives a free '90 Annis Venturas BLVD Elegy, a Crosstown District garage from Chapter 3, +10% on sales of owned vehicles, and 10% off at select shops (weapons, clothes, hair, tattoo, mod shops).",
   "sources": [
    "rockstar-gtaplus"
   ],
   "status": "VERIFIED_OFFICIAL"
  },
  {
   "fact": "GTA VI launched as a single-player experience; no GTA Online for VI exists yet. A 2027 online mode is reported (Bloomberg-sourced) but not announced by Rockstar.",
   "sources": [
    "gamesradar-online",
    "pcgamer-online",
    "beebom-online2027"
   ],
   "status": "VERIFIED_SECONDARY"
  },
  {
   "fact": "Fuel was observed at about $4.29/gal unleaded and $5.22/gal diesel in Key Lento (from streamer footage; may vary by region).",
   "sources": [
    "gamespot-gas"
   ],
   "status": "VERIFIED_SECONDARY"
  },
  {
   "fact": "A post-story cheat grants $250,000; trackers should flag cheat-sourced money separately.",
   "sources": [
    "gtabase-money"
   ],
   "status": "COMMUNITY_REPORTED"
  }
 ]
}
